# Study OS local development environment
# docker compose 会自动读取此文件；直接运行 API 时请通过 shell 设置变量，API 也会加载根目录 .env。
# 不配置数据库也能启动（/health 显示 disabled，/api/v1/* 返回 503）。切勿提交真实密钥。

# --- API ---
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
# 会话签名密钥；生产环境必须设置且至少 16 字符（开发环境有默认值）。
# SESSION_SECRET=change-me-to-a-long-random-value
# 浏览器来源白名单；开发环境默认已允许 localhost:3000 与 127.0.0.1:3000。
# CORS_ORIGINS=http://localhost:3000

# --- Database (可选；设置后 /health 会真实探测) ---
POSTGRES_USER=studyos
POSTGRES_PASSWORD=studyos
POSTGRES_DB=studyos
POSTGRES_PORT=5432
# DATABASE_URL=postgres://studyos:studyos@127.0.0.1:5432/studyos

# --- AI（默认关闭；示例：DeepSeek 使用 OpenAI 兼容协议） ---
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=sk-your-key
# AI_MODEL=deepseek-chat
# AI_MONTHLY_BUDGET_USD=5
# AI_COST_PER_1K_USD=0.0007
# 本地 Ollama 示例：AI_PROVIDER=ollama, AI_BASE_URL=http://127.0.0.1:11434, AI_MODEL=llama3.1

# 本地嵌入（用于语义检索/RAG；首次使用会下载模型）
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# HF_ENDPOINT=https://hf-mirror.com
# EMBEDDING_CACHE_DIR=.cache/embeddings

# --- 对象存储（默认本地磁盘；S3 兼容服务如 MinIO/Cloudflare R2） ---
# STORAGE_DRIVER=local
# S3_BUCKET=study-os
# S3_REGION=us-east-1
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=minio
# S3_SECRET_ACCESS_KEY=minio-secret
# S3_FORCE_PATH_STYLE=true

# --- Web ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
